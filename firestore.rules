rules_version = '2';

// Dayzift security rules (Firestore)
// Paste into Firebase console → Firestore Database → Rules → Publish.
// A product of LIT America — www.litamerica.net
//
// Who can do what:
//   Platform admin  — everything (manages all businesses).
//   Owners          — everything inside their own business, including the books and invoices.
//   Crew            — their business's jobs, team and shifts. Not the books, bookings or rewards.
//   Customers       — their own profile, their own booking requests and their own points.
//   Clients         — one invoice each, through the private link the business sends them.
//   Everyone else   — nothing.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function isPlatformAdmin() {
      return signedIn() && request.auth.token.email != null
        && myEmail() in ['samala_netha@yahoo.com'];
    }

    // ---------- business membership ----------
    function bizData(b) { return get(/databases/$(database)/documents/businesses/$(b)).data; }
    function ownsData(d) { return signedIn() && (uid() in d.get('ownerUids', []) || d.get('ownerUid', '') == uid()); }
    function crewOfData(d) { return signedIn() && uid() in d.get('crewUids', []); }
    function isOwner(b) { return isPlatformAdmin() || (b is string && ownsData(bizData(b))); }
    function isMember(b) {
      return isPlatformAdmin() || (b is string && (ownsData(bizData(b)) || crewOfData(bizData(b))));
    }
    // The business a record belongs to may never change.
    function sameBusiness() { return request.resource.data.get('businessId', null) == resource.data.get('businessId', null); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // A new business works inside Dayzift from day one (its trial), but nothing reaches the public under
    // its name until the platform admin verifies it: no invoice links or emails, no website bookings.
    // Businesses from before approvals existed have no status, and they count as verified.
    function verifiedBiz(b) {
      return b is string && exists(/databases/$(database)/documents/businesses/$(b))
        && !(bizData(b).get('status', '') in ['pending', 'suspended', 'archived']);
    }
    function shortText(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }

    // ---------- businesses ----------
    match /businesses/{b} {
      function invitedOwner(d) { return verifiedEmail() && myEmail() in d.get('pendingOwnerEmails', []); }

      // get on a name that isn't taken yet is allowed (used to pick a free web address); it reveals nothing.
      allow get: if resource == null || isPlatformAdmin() || ownsData(resource.data) || crewOfData(resource.data) || invitedOwner(resource.data);
      allow list: if isPlatformAdmin() || ownsData(resource.data) || invitedOwner(resource.data);

      // New businesses start "pending" with the creator as the only owner. The platform admin can pre-register.
      // No email confirmation needed here: until the platform admin verifies it, nothing it does reaches the public.
      allow create: if isPlatformAdmin() || (
        signedIn() && request.auth.token.email != null
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('ownerUids', []) == [uid()]
        && request.resource.data.get('ownerUid', uid()) == uid()
        && request.resource.data.get('crewUids', []).size() == 0
        && !('stripe' in request.resource.data)
      );

      allow update: if isPlatformAdmin()
        // owners run their business but can't approve or un-suspend it themselves,
        // and can't change which Stripe account card payments go to (only DayZift's server sets that)
        || (ownsData(resource.data)
            && request.resource.data.get('status', '') == resource.data.get('status', '')
            && request.resource.data.get('stripe', null) == resource.data.get('stripe', null))
        // an invited co-owner accepts their own invite: adds only themself, removes only their invite
        || (invitedOwner(resource.data)
            && changedOnly(['ownerUids', 'ownerEmails', 'pendingOwnerEmails'])
            && request.resource.data.get('ownerUids', []).toSet() == resource.data.get('ownerUids', []).toSet().union([uid()].toSet())
            && request.resource.data.get('ownerEmails', []).toSet() == resource.data.get('ownerEmails', []).toSet().union([myEmail()].toSet())
            && request.resource.data.get('pendingOwnerEmails', []).toSet() == resource.data.get('pendingOwnerEmails', []).toSet().difference([myEmail()].toSet()))
        // a crew member joins: only allowed when their team-member record in this business is linked to them
        || (signedIn()
            && changedOnly(['crewUids', 'lastCrewJoin'])
            && request.resource.data.get('crewUids', []).toSet() == resource.data.get('crewUids', []).toSet().union([uid()].toSet())
            && request.resource.data.lastCrewJoin is string
            && getAfter(/databases/$(database)/documents/employees/$(request.resource.data.lastCrewJoin)).data.get('userId', '') == uid()
            && getAfter(/databases/$(database)/documents/employees/$(request.resource.data.lastCrewJoin)).data.get('businessId', '') == b
            && getAfter(/databases/$(database)/documents/employees/$(request.resource.data.lastCrewJoin)).data.get('active', true) != false);

      // A client business can never be deleted, not even by the platform admin. Archive it instead
      // (status "archived"): it keeps every record and can be restored. Only an unapproved sign-up
      // (status "pending", no data yet) can be rejected and removed.
      allow delete: if isPlatformAdmin() && resource.data.get('status', '') == 'pending';
    }

    // ---------- booking calendar (public) ----------
    // The days a business takes bookings (and which are full), read by its public website. Holds only the calendar.
    match /publicCalendars/{b} {
      allow read: if true;
      allow write: if false;   // kept in step by Cloud Functions from the owner's settings and the job board
    }

    // ---------- team members ----------
    match /employees/{e} {
      function inviteForMe() {
        return verifiedEmail() && resource.data.get('email', '') == myEmail() && resource.data.get('userId', null) == null;
      }
      allow read: if isMember(resource.data.get('businessId', null))
        || (signedIn() && resource.data.get('userId', null) == uid())
        || inviteForMe();
      allow create: if isOwner(request.resource.data.get('businessId', null));
      allow update: if (isOwner(resource.data.get('businessId', null)) && sameBusiness())
        // "This is me": a crew member links themself to an unlinked name on their team
        || (isMember(resource.data.get('businessId', null)) && changedOnly(['userId'])
            && resource.data.get('userId', null) == null && request.resource.data.userId == uid())
        // accepting an invite sent to my confirmed email
        || (inviteForMe() && changedOnly(['userId']) && request.resource.data.userId == uid());
      allow delete: if isOwner(resource.data.get('businessId', null));
    }

    // ---------- day-to-day work: owners and crew ----------
    match /jobs/{id} {
      allow read: if isMember(resource.data.get('businessId', null));
      allow create: if isMember(request.resource.data.get('businessId', null));
      allow update: if isMember(resource.data.get('businessId', null)) && sameBusiness();
      allow delete: if isMember(resource.data.get('businessId', null));
    }
    // Live locations: owners see the whole team; a crew member sees and shares only their own.
    // (The document id is the team member's id, and that record says which account it belongs to.)
    match /locations/{id} {
      function myTeamRecord() {
        return signedIn() && get(/databases/$(database)/documents/employees/$(id)).data.get('userId', '') == uid();
      }
      allow read: if myTeamRecord() || isOwner(resource.data.get('businessId', null));
      allow create: if (myTeamRecord() && isMember(request.resource.data.get('businessId', null)))
        || isOwner(request.resource.data.get('businessId', null));
      allow update: if (myTeamRecord() || isOwner(resource.data.get('businessId', null))) && sameBusiness();
      allow delete: if isOwner(resource.data.get('businessId', null));
    }

    // Shift log: start, end, location trail and job check-ins for each shift.
    // A crew member creates and adds to their own shifts and can read only their own.
    // Owners read everything in their business and can fix times. Nobody else sees it.
    match /shifts/{id} {
      function myTeamRecordFor(empId) {
        return signedIn() && get(/databases/$(database)/documents/employees/$(empId)).data.get('userId', '') == uid();
      }
      allow read: if (signedIn() && resource.data.get('userId', '') == uid())
        || isOwner(resource.data.get('businessId', null));
      allow create: if isOwner(request.resource.data.get('businessId', null))
        || (isMember(request.resource.data.get('businessId', null))
            && request.resource.data.get('userId', '') == uid()
            && myTeamRecordFor(request.resource.data.get('empId', '')));
      // crew can only add points and job check-ins, and close the shift; they can't rewrite its start
      allow update: if (isOwner(resource.data.get('businessId', null)) && sameBusiness())
        || (signedIn() && resource.data.get('userId', '') == uid() && sameBusiness()
            && changedOnly(['end', 'points', 'events'])
            && request.resource.data.get('points', []).size() <= 500
            // the end time is set once, and never in the future
            && (request.resource.data.get('end', null) == resource.data.get('end', null)
                || (resource.data.get('end', null) == null
                    && request.resource.data.end is int
                    && request.resource.data.end <= request.time.toMillis() + 120000)));
      allow delete: if isOwner(resource.data.get('businessId', null));
    }

    // Projects (remodels, builds): the whole crew sees them, owners delete them.
    match /projects/{id} {
      allow read: if isMember(resource.data.get('businessId', null));
      allow create: if isMember(request.resource.data.get('businessId', null));
      allow update: if isMember(resource.data.get('businessId', null)) && sameBusiness();
      allow delete: if isOwner(resource.data.get('businessId', null));
    }

    // ---------- owners only: subcontractors and pay rates ----------
    match /companies/{id} {
      allow read, delete: if isOwner(resource.data.get('businessId', null));
      allow create: if isOwner(request.resource.data.get('businessId', null));
      allow update: if isOwner(resource.data.get('businessId', null)) && sameBusiness();
    }
    // One pay rule per team member (document id = team member id). Crew can't see anyone's pay.
    // A pay period's payroll: reviews, approvals and recorded payments with who and when.
    // Kept for the record: never deleted (a mistaken payment is voided, not erased).
    match /payrollRuns/{id} {
      allow read: if isOwner(resource.data.get('businessId', null));
      allow create: if isOwner(request.resource.data.get('businessId', null));
      allow update: if isOwner(resource.data.get('businessId', null)) && sameBusiness();
      allow delete: if false;
    }

    match /payRates/{id} {
      allow read, delete: if isOwner(resource.data.get('businessId', null));
      allow create: if isOwner(request.resource.data.get('businessId', null));
      allow update: if isOwner(resource.data.get('businessId', null)) && sameBusiness();
    }

    // ---------- the books: owners only ----------
    match /expenses/{id} {
      allow read, delete: if isOwner(resource.data.get('businessId', null));
      allow create: if isOwner(request.resource.data.get('businessId', null));
      allow update: if isOwner(resource.data.get('businessId', null)) && sameBusiness();
    }

    // ---------- invoices: owners only ----------
    match /invoices/{id} {
      allow read, delete: if isOwner(resource.data.get('businessId', null));
      allow create: if isOwner(request.resource.data.get('businessId', null));
      allow update: if isOwner(resource.data.get('businessId', null)) && sameBusiness();
    }
    // The client's copy of an invoice. Its id is a long random key that only the link carries,
    // so anyone with the link can open that one invoice, and nobody can list them.
    // The client's browser may only stamp the time they first opened it.
    match /publicInvoices/{key} {
      allow get: if true;
      allow list: if isOwner(resource.data.get('businessId', null));
      allow create: if isOwner(request.resource.data.get('businessId', null)) && key.size() >= 20
        && verifiedBiz(request.resource.data.get('businessId', null));
      allow update: if (isOwner(resource.data.get('businessId', null)) && sameBusiness())
        || (changedOnly(['viewedAt']) && resource.data.get('viewedAt', null) == null
            && request.resource.data.viewedAt is int && request.resource.data.viewedAt <= request.time.toMillis() + 120000);
      allow delete: if isOwner(resource.data.get('businessId', null));
    }
    // Emails waiting to go out (sent by a Cloud Function, which also checks the sender is an owner).
    match /mail/{id} {
      allow create: if isOwner(request.resource.data.get('businessId', null))
        && request.resource.data.get('createdBy', '') == uid()
        && request.resource.data.get('to', '') is string && request.resource.data.to.size() < 200
        && request.resource.data.get('kind', '') == 'invoice'
        && verifiedBiz(request.resource.data.get('businessId', null));
      allow read: if isOwner(resource.data.get('businessId', null));
      allow update, delete: if false;
    }

    // ---------- website customers ----------
    match /customers/{c} {
      allow read: if (signedIn() && c == uid()) || isOwner(resource.data.get('businessId', null));
      allow create, update: if signedIn() && c == uid();
      allow delete: if (signedIn() && c == uid()) || isPlatformAdmin();
    }

    match /bookings/{id} {
      allow read: if (signedIn() && resource.data.get('uid', null) == uid()) || isOwner(resource.data.get('businessId', null));
      // customers send requests as themselves, always "pending", only to a verified business,
      // and with sensible sizes (each request emails the owner)
      allow create: if signedIn()
        && request.resource.data.get('uid', null) == uid()
        && request.resource.data.get('status', '') == 'pending'
        && verifiedBiz(request.resource.data.get('businessId', null))
        && request.resource.data.keys().size() <= 40
        && shortText(request.resource.data, 'name', 120)
        && shortText(request.resource.data, 'phone', 120)
        && shortText(request.resource.data, 'email', 200)
        && shortText(request.resource.data, 'service', 200)
        && shortText(request.resource.data, 'size', 120)
        && shortText(request.resource.data, 'details', 3000);
      allow update: if (isOwner(resource.data.get('businessId', null)) && sameBusiness())
        // the customer can ask for a new date or cancel their own upcoming booking, nothing else
        || (signedIn() && resource.data.get('uid', null) == uid()
            && resource.data.get('status', 'pending') in ['pending', 'confirmed']
            && changedOnly(['change', 'status'])
            && ((request.resource.data.change.type == 'reschedule'
                 && request.resource.data.change.status == 'pending'
                 && request.resource.data.change.to is string
                 && request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending'))
             || (request.resource.data.change.type == 'cancel'
                 && request.resource.data.change.status == 'done'
                 && request.resource.data.get('status', '') == 'cancelled')));
      allow delete: if isOwner(resource.data.get('businessId', null));
    }

    // Points history is append-only: owners add entries, customers read their own.
    match /pointsLedger/{id} {
      allow read: if (signedIn() && resource.data.get('uid', null) == uid()) || isOwner(resource.data.get('businessId', null));
      allow create: if isOwner(request.resource.data.get('businessId', null));
      allow update, delete: if isPlatformAdmin();
    }

    // ---------- accounts and phones ----------
    match /crewAccounts/{u} {
      allow get, create, update: if signedIn() && u == uid();
      allow list: if isPlatformAdmin();
      // people can delete their own account record when they delete their account in the app
      allow delete: if isPlatformAdmin() || (signedIn() && u == uid());
    }

    // "Delete my account" in the app leaves a note here for LIT America to remove the rest within 30 days.
    match /accountDeletions/{u} {
      allow create: if signedIn() && u == uid()
        && request.resource.data.get('uid', '') == uid()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'businessId', 'businessName', 'role', 'deleteBusiness', 'platform', 'requestedAt']);
      allow read, delete: if isPlatformAdmin();
    }

    match /devices/{token} {
      // the email on a phone must be the signed-in account's own (admin alerts go to phones by email)
      function ownEmailOnly() {
        return request.resource.data.get('email', '') == ''
          || (request.auth.token.email != null && request.resource.data.get('email', '') == myEmail());
      }
      allow create: if signedIn() && request.resource.data.get('uid', null) == uid() && ownEmailOnly();
      // a phone that changes hands re-registers under the new account
      allow update: if signedIn() && request.resource.data.get('uid', null) == uid() && ownEmailOnly();
      allow delete: if signedIn() && resource.data.get('uid', null) == uid();
      allow read: if isPlatformAdmin();
    }

    // ---------- anything else: platform admin only ----------
    // (Cloud Functions use the admin SDK and are not limited by these rules.)
    // No blanket delete: deleting records goes through the rules above (and a business never).
    match /{document=**} {
      allow read, create, update: if isPlatformAdmin();
    }
  }
}
